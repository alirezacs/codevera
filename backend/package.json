{
  "name": "codevera-nest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Codevera NestJS and PostgreSQL API",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node --watch --import ts-node/esm src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src scripts test",
    "db:migrate": "TS_NODE_PROJECT=tsconfig.scripts.json node --loader ts-node/esm scripts/migrate.ts",
    "db:seed": "ts-node --esm scripts/seed.ts",
    "admin:create": "ts-node --esm scripts/create-admin.ts",
    "test": "ts-node --esm test/integration.ts",
    "test:serve": "ts-node --esm test/serve.ts",
    "db:import-legacy": "ts-node --esm scripts/import-legacy.ts",
    "db:start": "ts-node --esm scripts/start-local-db.ts",
    "prestart:dev": "npm run db:start"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.0",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
