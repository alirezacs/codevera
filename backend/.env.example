NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://codevera:change-me@localhost:5432/codevera
CORS_ORIGINS=http://localhost:3000
SESSION_HOURS=8
DOCS_ENABLED=true
# Production TLS: set PGSSL=true and PGSSL_CA_FILE to a trusted CA file if required.
PGSSL=false

HOST=127.0.0.1
TEST_DATABASE_URL=postgresql://codevera:change-me@localhost:5432/codevera_test
POSTGRES_PASSWORD=replace-with-a-long-random-password
# First owner only: supply these temporarily when running npm run admin:create.
# ADMIN_EMAIL=you@your-company.com
# ADMIN_NAME=Your Name
# ADMIN_PASSWORD=choose-a-unique-password-of-at-least-12-characters
BROWSER_TEST_DATABASE_URL=postgresql://codevera:change-me@localhost:5432/codevera_browser_test
